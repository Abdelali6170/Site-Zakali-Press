# Zakali Press — gabarit de configuration.
#
# Copier en « .env » et remplir. Le .env n'est jamais versionne.
# En production, ces valeurs se posent dans les variables d'environnement du
# panneau Hostinger — pas dans un fichier, qui n'atteindrait jamais le serveur.

# ── Adresse publique ─────────────────────────────────────────────────────────
# Sert aux adresses absolues : canoniques, plan de site, donnees de partage.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Le quai de livraison ─────────────────────────────────────────────────────
# Le dossier ou l'atelier depose les ouvrages finis. Le site le lit, il n'y
# ecrit jamais, et il n'entre JAMAIS dans la machine de production.
#
# Sur le poste, pendant la transition, il peut designer le quai actuel :
#   LIVRES_DIR=c:/OpenStax/Zakali_Edition/Livres
# Absent, il vaut « ./Livres ».
#
# Sur le serveur, il n'y a pas de quai : les fichiers viennent du stockage
# objet, et l'index versionne suffit a les decrire.
LIVRES_DIR=

# ── Base de donnees ──────────────────────────────────────────────────────────
# Deux tables : comptes et commandes. PostgreSQL manage, hors serveur.
DATABASE_URL=

# ── Sessions ─────────────────────────────────────────────────────────────────
# Signe le cookie de session. Generer une valeur reelle :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# ── Stockage objet ───────────────────────────────────────────────────────────
# Renseigne le jour de la mise en ligne. Sans ces valeurs, le site sert les
# fichiers depuis le quai local — c'est le mode de developpement.
STOCKAGE_ENDPOINT=
STOCKAGE_BUCKET=
STOCKAGE_CLE=
STOCKAGE_SECRET=
